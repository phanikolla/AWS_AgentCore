        },
        {
          "type": "SEMANTIC",
          "name": "CustomerSupportSemantic",
          "description": "Stores facts from conversations",
          "namespaceTemplates": [
            "support/customer/{actorId}/semantic/"
          ]
        }
      ]
    }
  ],
